<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinLimit.ViewModels"
    x:DataType="vm:LoginPageViewModel"
    x:Class="WinLimit.Views.LoginPageView">
    <StackPanel HorizontalAlignment="Center">
        <TextBlock FontSize="24" Text="Account Page" />
        <StackPanel IsVisible="{Binding IsLoggedOut}">
            <TextBlock FontSize="16" Text="Username"/>
            <TextBox Watermark="Enter Your Username" Text="{Binding Username}" Width="250"/>
            <TextBlock FontSize="16" Text="Password"/>
            <TextBox Watermark="Enter Your Password" Text="{Binding Password}"/>
            <TextBlock FontSize="16" Text="{Binding LoginPageErrorMessage}"/>
            <Button Margin="4,0,4,0" Content="Login" Command="{Binding LoginCommand}" HorizontalAlignment="Center"/>
            <Button Content="Register" Command="{Binding RegisterCommand}" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsLoggedIn}">
            <TextBlock FontSize="16" Text="You are logged in!"/>
            <TextBlock FontSize="16" Text="{Binding UserEmail}"/>
            <Button Content="Logout" Command="{Binding LogoutCommand}" HorizontalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</UserControl>
