<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="WinLimit.PopUpWindow"
    Title="App Blocked"
    WindowStartupLocation="CenterScreen"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:WinLimit.Views"
    xmlns:vm="using:WinLimit.ViewModels"
    x:DataType="vm:PopUpWindowViewModel"
    d:DesignHeight="200"
    d:DesignWidth="200"
    Icon="/Assets/avalonia-logo.ico">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Name="Message" Text="Pop Up Window"/>
        <Button Command="{Binding StopLoopCommand}" Content="Stop Loop"/>
    </StackPanel>
</Window>