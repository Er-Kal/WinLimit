<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="WinLimit.Views.PopUpWindow"
    Title="App Blocked"
    WindowStartupLocation="CenterScreen"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:WinLimit.Views"
    xmlns:vm="using:WinLimit.ViewModels"
    x:DataType="vm:PopUpWindowViewModel"
    Height="400"
    Width="500"
    Icon="/Assets/avalonia-logo.ico">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="If you would like to disable the blocking, type the extract displayed" Padding="0,0,5,0"/>
        <TextBlock Text="{Binding TextExtract}" MaxWidth="450" TextWrapping="Wrap"/>
        <TextBox Watermark="Re-Type the extract here" MaxWidth="450" Text="{Binding UserInput}" TextWrapping="Wrap"/>
        <Button Command="{Binding StopLoopCommand}" Content="Attempt Override"/>
        <TextBlock Name="Message" Text="{Binding ErrorMessage}"/>
    </StackPanel>
</Window>