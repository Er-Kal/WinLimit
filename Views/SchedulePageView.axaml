<UserControl
    x:Class="WinLimit.Views.SchedulePageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinLimit.ViewModels"
    xmlns:m="using:WinLimit.Models"
    xmlns:views="using:WinLimit.Views"
    x:DataType="vm:SchedulePageViewModel"
    VerticalAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    x:Name="SchedulePage">
    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="Schedule:"/>
            <ComboBox MinWidth="200"
                      ItemsSource="{Binding ScheduleOptions}"
                      SelectedItem="{Binding SelectedScheduleOption}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="m:ScheduleOption">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Command="{Binding EditConfigCommand}" Content="Edit Config"/>
			<Button Command="{Binding AddRuleCommand}" Content="Add A Rule"/>
			<TextBlock VerticalAlignment="Center" Text="To remove a rule, click on the block above"/>
        </StackPanel>
        <ItemsControl Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ItemsSource="{Binding WeekDays}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontSize="24" Text="{Binding Key}"/>
                        <ItemsControl
                            Grid.Row="1"
                            Padding="4"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Value.ScheduleRules}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <views:SchedulePanel ClipToBounds="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button VerticalAlignment="Stretch"
                                            Command="{Binding #SchedulePage.DataContext.RemoveScheduleRuleCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid>
											<TextBlock Text="{Binding StartHour, StringFormat='{}{0}:00'}"
                                                       VerticalAlignment="Top"/>
											<TextBlock Text="{Binding EndHour, StringFormat='{}{0}:00'}"
                                                       VerticalAlignment="Bottom"/>
                                        </Grid>
                                        </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
